# ==============================================================================
# VisionCart AI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & JWT Auth
# Generate random 32+ byte string in production: openssl rand -hex 32
JWT_SECRET_KEY=visioncart_super_secret_jwt_key_change_in_production_99881122
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# In Docker: postgresql+asyncpg://visioncart:visioncart_secret@postgres:5432/visioncart_db
# For SQLite local fallback: sqlite+aiosqlite:///./visioncart.db
DATABASE_URL=postgresql+asyncpg://visioncart:visioncart_secret@postgres:5432/visioncart_db
SYNC_DATABASE_URL=postgresql://visioncart:visioncart_secret@postgres:5432/visioncart_db

# Detector Service Configuration
# DETECTOR_MODE: "mock" (deterministic mock for tests/CI) or "yolo" (live YOLOv8 inference)
DETECTOR_MODE=mock
MODEL_PATH=ml/weights/yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
DETECTOR_DEVICE=cpu

# Temporal Cart Smoothing Rules
# Item counts after N consecutive frames of appearance
SMOOTHING_N_FRAMES=3
# Item removed from candidate detection buffer after M consecutive frames of absence
SMOOTHING_M_FRAMES=5

# Seed Demo Credentials
SEED_ADMIN_EMAIL=admin@visioncart.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_CASHIER_EMAIL=cashier@visioncart.local
SEED_CASHIER_PASSWORD=Cashier@1234

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Rate Limiting (requests per minute on /api/detection/detect)
DETECTION_RATE_LIMIT=300

